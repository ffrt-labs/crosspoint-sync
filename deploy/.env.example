# Copy to deploy/.env and fill in. Both required values stop `docker compose`
# with an error when empty.

# Host IP both services publish on: a LAN or Tailscale/NetBird address, never
# 0.0.0.0. Docker-published ports bypass ufw, so this is the actual access control.
# The Xteink only reaches a LAN address. See docs/deploy.md.
BIND_ADDR=

# Bearer key the SD plugin sends to the progress endpoint. It sits in plaintext on
# the SD card, so use it for nothing else. Generate: openssl rand -hex 32
PROGRESS_API_KEY=

# Set to true only while registering a user, then back to false and recreate.
KOSYNC_ENABLE_USER_REGISTRATION=false
